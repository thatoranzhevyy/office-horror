{
  "name": "office-horror",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch --import tsx server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "tsx": "^4.20.5",
    "three": "0.180.0",
    "vue": "3.5.22",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.8"
  }
}
